{
  "name": "nextjs-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preinstall": "pnpm dlx only-allow pnpm",
    "tsgo": "tsgo",
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest run -c tests/vitest.ui.config.ts",
    "test:prod": "vitest run -c tests/vitest.integration.config.ts tests/production",
    "test:build-parity": "vitest run -c tests/vitest.integration.config.ts tests/build",
    "test:e2e": "playwright test",
    "test:e2e:dark": "playwright test --project=chromium-dark",
    "test:e2e:clean": "node scripts/kill-e2e-port.mjs",
    "test:e2e:fresh": "pnpm build && pnpm test:e2e",
    "test:all": "vitest run",
    "lighthouse:mobile": "node scripts/lighthouse-mobile.js",
    "lint": "eslint --cache",
    "lint:fast": "oxlint --ignore-pattern 'tests/**' --ignore-pattern 'scripts/ts_converters/**' --nextjs-plugin --react-plugin --react-perf-plugin",
    "check:deps": "depcheck",
    "format:fast": "oxfmt --write .",
    "type-check": "tsc --noEmit",
    "type-check:fast": "tsgo --noEmit",
    "security-check": "pnpm audit --audit-level=high && secretlint \"**/*\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@vercel/config": "^0.6.1",
    "next": "16.3.1",
    "papaparse": "^5.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "arquero": "^8.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "iconv-lite": "^0.7.3",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "linkedom": "^0.18.13",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "secretlint": "13.0.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
