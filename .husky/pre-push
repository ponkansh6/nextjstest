#!/bin/sh

PUSH_FILES=$(git diff --name-only origin/main...HEAD 2>/dev/null)

# --- Spec staleness check ---
# ソースコードやテストが変更された場合、spec.md の更新を確認
if echo "$PUSH_FILES" | grep -qE "^(src/|server/|tests/)"; then
  if echo "$PUSH_FILES" | grep -qE "openspec/specs/.*/spec\.md"; then
    echo "Spec file updated."
  else
    echo ""
    echo "⚠️  Warning: Source/test files changed but openspec/specs/nextjstest/spec.md was NOT updated."
    echo "   Please review whether the spec needs updating before pushing."
    echo "   (To skip this check temporarily, use: git push --no-verify)"
    echo ""
    # warning only — do not block push
  fi
fi

# --- Test file staleness check ---
if echo "$PUSH_FILES" | grep -qE "^src/"; then
  if echo "$PUSH_FILES" | grep -qE "^tests/"; then
    echo "Test files updated."
  else
    echo ""
    echo "⚠️  Warning: src/ files changed but tests/ was NOT updated."
    echo "   Consider adding or updating tests for the changed source code."
    echo ""
  fi
fi

# --- Full unit/component test suite ---
# パスパターンによる条件実行はやめ、push時は無条件で全テストを実行する。
# 理由: vitest related（pre-commit）はimportグラフに乗らないファイル（例: src/app/page.tsx）を
# 変更しても「関連テスト0件」で無言パスする。push時の条件付きtest:uiも、パスパターンに
# 一致しない変更（page.tsx単体やserver/**単体など）を素通りさせていた。
echo "Running full unit/component test suite..."
pnpm run test:all
TEST_EXIT_CODE=$?
if [ $TEST_EXIT_CODE -ne 0 ]; then
  echo "Unit/component tests failed with code $TEST_EXIT_CODE"
  exit $TEST_EXIT_CODE
fi
echo "Unit/component tests passed!"

# --- E2E tests ---
# 実ビルド・実サーバー・実ブラウザで page.tsx の実行結果を検証。
# 今回のバグ（page.tsx の quarterlyKeys 欠落）はここで検知される。
echo ""
echo "Running E2E tests (page.tsx with real build/server/browser)..."
pnpm run test:e2e
E2E_EXIT_CODE=$?
if [ $E2E_EXIT_CODE -ne 0 ]; then
  echo "E2E tests failed with code $E2E_EXIT_CODE"
  exit $E2E_EXIT_CODE
fi
echo "E2E tests passed!"

exit 0
